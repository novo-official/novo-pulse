# ---------------------------------------------------------------------------
# Novo Pulse - environment
# Copy to .env and adjust. Every value below has a safe default.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
DEBUG=true
SECRET_KEY=dev-only-change-me
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Demo -------------------------------------------------------------------
# true  -> synthetic data + precomputed artifacts are served.
# false -> nothing is fabricated; endpoints return "no data available".
DEMO_MODE=true

# --- Database ---------------------------------------------------------------
# Empty => SQLite at backend/db.sqlite3
# Postgres example: postgres://novo:novo@localhost:5432/novopulse
DATABASE_URL=

# --- Optional ML components (all degrade gracefully) ------------------------
ENABLE_CHRONOS=false
ENABLE_NEURALFORECAST=false
ENABLE_LOCAL_LLM=false
CHRONOS_MODEL_ID=amazon/chronos-2
HF_HOME=models/hf_cache

# --- Local LLM (insight narration only, never forecasting) ------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- Forecasting defaults ---------------------------------------------------
DEFAULT_HORIZON=90
PRIMARY_METRIC=wape
TRAINING_PROFILE=demo
RANDOM_SEED=42

# --- Task execution ---------------------------------------------------------
# true => training runs inline (no Redis/Celery needed).
SYNC_TASKS=true
CELERY_BROKER_URL=redis://localhost:6379/0

# --- Paths ------------------------------------------------------------------
RUNS_DIR=runs
DATA_DIR=data
REPORTS_DIR=reports

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
